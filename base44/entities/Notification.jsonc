{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient user id"
    },
    "problem_id": {
      "type": "string",
      "description": "Related problem id"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Notification category"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "message"
  ]
}